# Secrets — never bake into the image (mounted at runtime via docker-compose)
.env
.env.*
*.pem
*.key

# Version control
.git
.gitignore

# Python caches / virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local data (provided at runtime via the docker-compose volume mount)
data/

# Editor / IDE
.vscode/
.idea/

# Docker meta (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore

# Docs / logs
*.md
*.log
