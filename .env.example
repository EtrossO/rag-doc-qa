# LLM Provider API Keys (set at least one)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model settings
MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Optional: persistent online storage (Supabase) -------------------------
# When set, vectors are stored in Supabase pgvector and uploaded documents in
# Supabase Storage, so the index survives Vercel cold starts / restarts.
# Follow the setup steps in README > "Persistent storage with Supabase".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=documents
SUPABASE_BUCKET=documents
